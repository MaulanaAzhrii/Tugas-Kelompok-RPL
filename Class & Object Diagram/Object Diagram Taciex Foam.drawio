1;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="pesanan1" target="detail2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="pesanan1" target="pembayaran1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="detail1" target="kasur1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="detail2" target="kasur2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;KETERANGAN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#D5E8D4;background:#D5E8D4&quot;&gt;■■■&lt;/span&gt; : Instance Class Utama (Transaksi)&lt;br&gt;&lt;span style=&quot;color:#DAE8FC;background:#DAE8FC&quot;&gt;■■■&lt;/span&gt; : Instance Master Data&lt;br&gt;&lt;span style=&quot;color:#FFF2CC;background:#FFF2CC&quot;&gt;■■■&lt;/span&gt; : Instance Pendukung / Lainnya" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="28" y="1430" width="280" height="77" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;CATATAN&lt;/b&gt;&lt;br&gt;• user1 (Pelanggan) terhubung dengan pelanggan1 dan memiliki session1 yang aktif.&lt;br&gt;• pelanggan1 membuat pesanan1 (Menunggu Konfirmasi) berisi detail1 (kasur1 x 1) dan detail2 (kasur2 x 2).&lt;br&gt;• Total 1.850.000 + 1.300.000 = 3.150.000.&lt;br&gt;• pembayaran1 sudah diunggah bukti transfernya dan menunggu verifikasi Admin.&lt;br&gt;• keranjang1 masih berisi item1 (kasur2 x 1) yang belum di-checkout.&lt;br&gt;• Data pada diagram ini hanya contoh ilustrasi." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="476" y="1404" width="700" height="128" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b style=&amp;quot;font-size:22px&amp;quot;&gt;OBJECT DIAGRAM&lt;/b&gt;&lt;br&gt;Sistem Informasi Penjualan Kasur pada UMKM Taciex Foam (Contoh Snapshot Data pada Waktu Tertentu)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="237" y="0" width="800" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>