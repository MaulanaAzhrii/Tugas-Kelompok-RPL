" parent="1" source="Pesanan" target="Pembayaran"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n27" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n26"><mxGeometry x="-0.82" y="-0.0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="n28" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n26"><mxGeometry x="0.82" y="-0.0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="n29" value="&lt;b&gt;KETERANGAN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#D5E8D4;background:#D5E8D4&quot;&gt;■■■&lt;/span&gt; : Class Utama (Transaksi)&lt;br&gt;&lt;span style=&quot;color:#DAE8FC;background:#DAE8FC&quot;&gt;■■■&lt;/span&gt; : Master Data&lt;br&gt;&lt;span style=&quot;color:#FFF2CC;background:#FFF2CC&quot;&gt;■■■&lt;/span&gt; : Pendukung / Lainnya" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="18" y="1869" width="230" height="77" as="geometry" /></mxCell><mxCell id="n30" value="&lt;b&gt;KETERANGAN RELASI&lt;/b&gt;&lt;br&gt;────── : Asosiasi (Association)&lt;br&gt;◆───── : Komposisi (Composition)&lt;br&gt;──────&amp;gt; : Asosiasi berarah&lt;br&gt;1 : Satu (Exactly One)&lt;br&gt;0..1 : Nol atau Satu&lt;br&gt;0..* : Nol atau Banyak&lt;br&gt;1..* : Satu atau Banyak" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="379" y="1835" width="260" height="145" as="geometry" /></mxCell><mxCell id="n31" value="&lt;b&gt;CATATAN&lt;/b&gt;&lt;br&gt;• Setiap pengguna (User) dapat memiliki banyak sesi login (Session).&lt;br&gt;• Pelanggan terhubung ke satu akun User (0..1); pelanggan yang diinput kasir boleh tanpa akun.&lt;br&gt;• Setiap pelanggan memiliki satu Keranjang berisi banyak ItemKeranjang.&lt;br&gt;• Setiap Pesanan milik satu Pelanggan dan memiliki minimal satu DetailPesanan.&lt;br&gt;• Satu Pesanan dapat memiliki banyak Pembayaran (misal: ditolak lalu diunggah ulang).&lt;br&gt;• DetailPesanan dan ItemKeranjang merujuk ke satu tipe Kasur." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="853" y="1843" width="620" height="128" as="geometry" /></mxCell><mxCell id="n32" value="&lt;b style=&amp;quot;font-size:22px&amp;quot;&gt;CLASS DIAGRAM&lt;/b&gt;&lt;br&gt;Sistem Informasi Penjualan Kasur pada UMKM Taciex Foam Berbasis Web" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="0" width="800" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>